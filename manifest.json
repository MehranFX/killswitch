{
	"manifest_version": 3,
	"name": "Real Kill Switch",
	"short_name": "Real Kill Switch",
	"description": "An enhanced extension to prevent access to websites depending on your public IP address with improved security and user experience.",
	"version": "2.1",
	"version_name": "2.1 Enhanced",
    "author": "github.com/maxisme",
	"background": {
		"service_worker": "background.js"
	},
	"icons": {
		"48": "/img/icon-48x48-red.png",
		"128": "/img/icon-128x128-red.png",
		"512": "/img/icon-512x512-red.png"
	 },
	"permissions": [
	   "storage",
	   "activeTab",
	   "scripting",
	   "tabs",
	   "declarativeNetRequest",
	   "webRequest",
	   "webNavigation",
	   "proxy",
	   "alarms",
	   "privacy",
	   "debugger"
	],
	"host_permissions": [
		"<all_urls>"
	],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["js/timezone_early_override.js"],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN"
        },
        {
            "matches": ["<all_urls>"],
            "js": ["js/privacy_protection.js"],
            "run_at": "document_start",
            "all_frames": true,
            "world": "ISOLATED"
        },
        {
            "matches": ["<all_urls>"],
            "js": ["js/webgl_spoofer.js"],
            "run_at": "document_start",
            "all_frames": true,
            "world": "MAIN"
        },
        {
            "matches": ["<all_urls>"],
            "js": ["js/timezone_stealth.js"],
            "run_at": "document_idle",
            "all_frames": true,
            "world": "ISOLATED"
        }
    ],
	"options_ui": {
		"page": "/html/options.html",
		"open_in_tab": false
	},
	"web_accessible_resources": [
		{
			"resources": [
				"html/blocked.html",
				"js/blocked.js",
				"js/webgl_spoofer.js",
				"js/timezone_inject_main.js",
				"js/privacy_inject_main.js",
				"js/stubs/fp_stub.js",
				"img/icon-48x48-red.png",
				"img/icon-128x128-red.png"
			],
			"matches": ["<all_urls>"]
		}
	],
	"action": {
		"default_icon": "/img/icon-48x48-grey.png",
		"default_popup": "/html/popup.html",
		"default_title": "Real Kill Switch"
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self';"
	}
}